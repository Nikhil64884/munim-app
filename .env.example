# ============================================
# Munim Ji AI — Environment Variables Template
# ============================================
# Copy this file to .env and fill in the real values:
#
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# NEVER commit the real .env file to Git.
# ============================================

# --- AI (REQUIRED) ---
# Get your key from: https://console.groq.com/keys
# Free tier: 30 req/min, 14,400 req/day
GROQ_API_KEY=your_groq_api_key_here

# --- JWT (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters in production (48 recommended).
JWT_SECRET=your_48_byte_random_secret_here

# --- OTP ---
# Options: dev | twilio | firebase
# dev = fixed OTP for local testing (NEVER in production — it lets anyone log
#       in as any phone number; the app refuses to boot with it when ENV=prod)
OTP_PROVIDER=dev
DEV_OTP=123456

# --- Twilio (only if OTP_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Firebase Admin verifies firebase_id_token sent to /api/auth/verify-otp.
# Set the project ID and configure Google Application Default Credentials.
# FIREBASE_PROJECT_ID=

# --- Environment ---
# Options: dev | prod | production
ENV=dev

# --- Optional (defaults shown) ---
# DATABASE_URL=sqlite:///./data/munim_ji.db
# LOG_LEVEL=INFO
# LOG_DIR=logs
# TIMEZONE=Asia/Kolkata
# MAX_REQUESTS_PER_MINUTE=30
# OTP_MAX_ATTEMPTS=5
# OTP_WINDOW_MINUTES=15
# OTP_SEND_MAX_ATTEMPTS=3
# OTP_SEND_WINDOW_MINUTES=15
# CONTEXT_EXPIRY_MINUTES=10
# UNDO_WINDOW_MINUTES=5
# CONFIRM_AMOUNT_THRESHOLD=5000
# MAX_AMOUNT_RUPEES=10000000
# GROQ_MODEL must be a model your API key can access (an unknown model skips
# retries and falls back to the rule-based parser).
# GROQ_MODEL=llama-3.3-70b-versatile
# WHISPER_MODEL=whisper-large-v3
# GROQ_TIMEOUT_SECONDS=20
# GROQ_MAX_RETRIES=2
# EXPORTS_DIR=exports
# EXPORT_RETENTION_HOURS=24
# BACKUP_DIR=data/backups
# BACKUP_RETENTION_DAYS=7
# MAX_AUDIO_MB=5
# CORS_ORIGINS=*

# --- Sentry (optional — for error monitoring) ---
# SENTRY_DSN=

# --- S3 Backups (optional — for cloud backups) ---
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# BACKUP_ENCRYPTION_KEY=

# --- Payment reminders (optional; UPI links omitted until configured) ---
# MERCHANT_UPI_ID=shopname@bank
# MERCHANT_NAME=Your Shop

# --- Play Store review account (optional) ---
# REVIEW_PHONE=+919999999999
# REVIEW_OTP=K7m2Qx9p